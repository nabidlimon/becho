# ==========================================
# BECHO: Autonomous AI Sales Engine Config
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Database (Default: SQLite for local dev, PostgreSQL for production)
# Local SQLite dev mode:
DATABASE_URL=sqlite+aiosqlite:///./becho.db
# Production PostgreSQL + pgvector example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/bechodb

# Redis (Optional in local dev - automatic in-memory fallback if not connected)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# AI Model Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# Meta Messenger Platform Credentials (Default fallback / App level)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=becho_secure_verify_token_2026
META_GRAPH_API_VERSION=v20.0

# Debounce Settings (Window buffer in seconds for rapid-fire multi-messages)
DEBOUNCE_WINDOW_SECONDS=3.5

# Merchant Security & Encryption (AES-256 32-byte Base64 key)
ENCRYPTION_KEY=s7z3v9y$B&E)H@McQfTjWnZr4u7x!A%D
